# Optional for public repositories; recommended for private repositories and higher rate limits.
GITHUB_TOKEN=

# The template registry is read from templates/registry.json in this repository/ref.
PAGIERA_TEMPLATES_REPOSITORY=voilabs/pagiera
PAGIERA_TEMPLATES_REF=main

# Set to local during template authoring to skip GitHub and read the monorepo templates directory.
# PAGIERA_TEMPLATES_SOURCE=local

# Canonical origin for canonical tags, Open Graph URLs, robots.txt and the sitemap.
# Defaults to https://www.pagiera.com, matching the current public redirect.
# NEXT_PUBLIC_SITE_URL is also accepted for existing deployments.
PAGIERA_SITE_URL=https://www.pagiera.com

# Production is indexable by default. Development and Vercel previews are not.
# Set false for any other staging deployment. Rebuild after changing this value.
# PAGIERA_SITE_INDEXABLE=false

# Optional: the token from Google Search Console's HTML-tag verification method.
# GOOGLE_SITE_VERIFICATION=
