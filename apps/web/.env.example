# Optional for public repositories; recommended for private repositories and higher rate limits.
GITHUB_TOKEN=

# The template registry is read from templates/registry.json in this repository/ref.
PAGIERA_TEMPLATES_REPOSITORY=voilabs/pagiera
PAGIERA_TEMPLATES_REF=main

# Set to local during template authoring to skip GitHub and read the monorepo templates directory.
# PAGIERA_TEMPLATES_SOURCE=local

# Canonical origin for canonical tags, Open Graph URLs, robots.txt and the sitemap.
# Defaults to https://pagiera.com when unset.
NEXT_PUBLIC_SITE_URL=https://pagiera.com
