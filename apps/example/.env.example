PAGIERA_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/pagiera
PAGIERA_REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Development automatically discovers the monorepo's templates/registry.json.
# Optional production/upstream registry override. Pagiera exposes it through its own API.
# PAGIERA_TEMPLATE_REGISTRY_URL=https://raw.githubusercontent.com/voilabs/pagiera/main/templates/registry.json

# Private hosts a page's data sources may fetch from, comma separated.
# Empty by default: an author-supplied URL must not be able to reach cloud
# metadata endpoints or internal services. Name a host here to open it, which
# is what a data source served by your own API on this machine needs.
PAGIERA_ALLOW_PRIVATE_HOSTS=
