{
  "name": "pagiera",
  "version": "0.2.0-alpha.34",
  "description": "Full-stack visual website editor with PostgreSQL, Redis and OpenRouter",
  "homepage": "https://pagiera.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voilabs/pagiera.git",
    "directory": "packages/pagiera"
  },
  "bugs": {
    "url": "https://github.com/voilabs/pagiera/issues"
  },
  "author": "Voi Labs",
  "keywords": [
    "visual-editor",
    "website-builder",
    "page-builder",
    "nextjs",
    "react",
    "no-code",
    "low-code",
    "cms",
    "openrouter",
    "postgresql"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/full.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./full": {
      "types": "./dist/full-editor.d.ts",
      "import": "./dist/full-editor.js"
    },
    "./full.css": "./dist/full.css",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./data": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/data.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json && npm run build:full && npm run build:full-css && npm run copy:styles && npm run copy:full-types",
    "build:full": "node scripts/build-full.mjs",
    "build:full-css": "node scripts/build-full-css.mjs",
    "copy:styles": "node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "copy:full-types": "node -e \"const fs=require('node:fs');fs.copyFileSync('src/full-editor.d.ts','dist/full-editor.d.ts');fs.copyFileSync('src/runtime.d.ts','dist/runtime.d.ts');fs.copyFileSync('src/server.d.ts','dist/server.d.ts')\"",
    "check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "esbuild": "^0.28.2",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.8",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.74",
    "drizzle-orm": "^1.0.0-rc.4",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "typescript": "^7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
